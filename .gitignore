# Local Firebase CLI cache/state (hosting deploy cache, emulator data, etc.)
.firebase/

# Ad-hoc one-off scratch scripts (e.g. account-cleanup helpers) — never
# meant to be committed, but easy to accidentally leave in the repo root.
__*.mjs

# Firebase Admin SDK service account key — used locally by scripts/prerender.js
# and scripts/generate-sitemap.js. Never commit this. See scripts/firebaseAdmin.js
# for the one-time setup step.
serviceAccountKey.json
*firebase-adminsdk*.json

