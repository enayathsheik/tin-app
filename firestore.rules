rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // ── STATS ──
      match /stats/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── CONTACTS ──
      match /contacts/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── SCHEDULE ──
      match /schedule/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── VISITS ──
      match /visits/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── LEAVE ──
      match /leave/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }
    }

    // ── STORES ─────────────────────────────────────────────
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (resource.data.contributorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── REPORTS ────────────────────────────────────────────
    match /reports/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── CLAIMS ─────────────────────────────────────────────
    match /claims/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── SUGGESTIONS ────────────────────────────────────────
    match /suggestions/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── CUSTOM CATEGORIES ──────────────────────────────────
    match /customCategories/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── ADMIN ONLY ─────────────────────────────────────────
    match /adminData/{docId} {
      allow read, write: if isAdmin();
    }

    // ── HELPER ─────────────────────────────────────────────
    // ── STAGED STORES ──────────────────────────────────────
    match /staged_stores/{docId} {
      allow read, write: if isAdmin();
    }
    // ── PULL JOBS ──────────────────────────────────────────
    match /pull_jobs/{docId} {
      allow read, write: if isAdmin();
    }
    // ── CONTRIBUTORS ───────────────────────────────────────
    match /contributors/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── INSPI POSTS ──────────────────────────────────────────
    match /inspiPosts/{postId} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    // ══ NEW: JOB LISTINGS ═══════════════════════════════════
    // Public read only shows approved listings; the poster can also always
    // see their own (pending/rejected) listing — needed for "My Job Posts"
    // on the Profile page. status:"approved" at create time is only allowed
    // if the poster's own users/{uid}.verificationStatus is really "verified" —
    // a client can't just claim verified_business for itself.
    match /jobListings/{jobId} {
      allow read: if resource.data.status == "approved"
        || isAdmin()
        || resource.data.postedByUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.postedByUid == request.auth.uid
        && (
          request.resource.data.status == "pending"
          || (request.resource.data.status == "approved"
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == "verified")
        );
      // The poster may flip jobStatus (live/filled/closed) on their own listing —
      // but nothing else on this doc; moderation status/content stays admin-only.
      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.postedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["jobStatus"])
        );
      allow delete: if isAdmin();
    }

    // ══ NEW: JOB APPLICATIONS ═══════════════════════════════
    // Read restricted to the applicant themselves or the poster of the
    // job being applied to (looked up via the application's jobId).
    match /jobApplications/{applicationId} {
      // Document ID is deterministic (`${jobId}_${applicantUid}`) — !exists() blocks
      // a second apply attempt at the rules layer, not just the UI.
      allow create: if request.auth != null
        && request.resource.data.applicantUid == request.auth.uid
        && !exists(/databases/$(database)/documents/jobApplications/$(applicationId));
      allow read: if request.auth != null
        && (resource.data.applicantUid == request.auth.uid
            || get(/databases/$(database)/documents/jobListings/$(resource.data.jobId)).data.postedByUid == request.auth.uid);
      // The job's poster may set applicantStatus (new/shortlisted/rejected/hired) —
      // and nothing else on this doc; the applicant can't edit their own application after submit.
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/jobListings/$(resource.data.jobId)).data.postedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicantStatus"]);
    }
    // ══ END NEW ═════════════════════════════════════════════

    // ── HANDLES (tinit ID) ─────────────────────────────────
    match /handles/{handle} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── PUBLIC PROFILES (tinit ID) ─────────────────────────
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ══ TENANCY — PHASE A ═══════════════════════════════════
    // Real org/membership model. organizations + conversations/messages
    // below supersede the admin-only scaffolding org and message docs
    // used to write; participantUids/participantOrgIds/senderUid/senderOrgId
    // are kept as-is on conversations/messages since functions/ai.js and
    // the vendored ai-foundation context builder read them by those exact
    // names — only orgId/scope/teamId/createdBy are new, additive fields.

    // ── ORGANIZATIONS ──
    match /organizations/{orgId} {
      // orgId == own uid is a user's deterministic solo-org slot (see
      // lib/tenancy.js createOrganization) — they must be able to read it,
      // to check whether they've bootstrapped it yet, before any
      // membership (and thus isActiveMember) exists.
      allow read: if isActiveMember(orgId) || (signedIn() && orgId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if hasRole(orgId, ['owner', 'admin']);
    }

    // ── MEMBERSHIPS ──
    match /memberships/{membershipId} {
      // The last clause lets a user always read their own deterministic
      // self-membership doc ({uid}_{uid}) even before it exists, so the
      // bootstrap self-check doesn't hit a null-resource rule error on a
      // nonexistent doc. Scoped to exactly their own id — no broader than
      // the existing uid == auth.uid read clause already grants once the
      // doc exists.
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || hasRole(resource.data.orgId, ['owner', 'admin', 'manager'])
          || membershipId == request.auth.uid + '_' + request.auth.uid);
      // Bootstrap: a user may self-grant 'owner' only on the org they just created.
      // Otherwise, only an existing owner/admin may create memberships (invites).
      allow create: if
        (request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.createdBy == request.auth.uid)
        || hasRole(request.resource.data.orgId, ['owner', 'admin']);
      allow update, delete: if hasRole(resource.data.orgId, ['owner', 'admin']);
    }

    // ── ORGANIZATION MEMBERSHIPS ── (legacy dev-test scaffolding, admin-only)
    match /organizationMemberships/{membershipId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── CONVERSATIONS ──
    // ══ IDENTITY-FIRST — PHASE 1 ═══════════════════════════════
    // `context` ('personal' | 'organization') is the auth discriminator,
    // additive alongside the pre-existing `type` (direct|group) and `scope`
    // (personal|team|org|external) fields, which keep their prior meaning —
    // `scope` becomes a sub-classifier under context=='organization' (org vs
    // team visibility) and denormalized/historical metadata under
    // context=='personal'; it is never consulted for personal-context auth.
    // A doc with no `context` field yet (context == null) is a pre-Phase-1
    // conversation awaiting the one-time backfill (see
    // functions/scripts/backfill-conversation-context.js) — every context==null
    // branch below falls back to exactly today's isActiveMember(orgId) +
    // canAccessConversation() check, unchanged, so an un-backfilled doc is
    // never more open than it was before this rules deploy. That fallback is
    // read-only insurance, removed only once a verified count of
    // context==null docs hits zero.
    match /conversations/{conversationId} {
      // resource == null (the doc doesn't exist) must be checked before
      // dereferencing resource.data — Firestore evaluates security rules on
      // get() reads of NON-existent documents too, and resource.data on a
      // null resource throws a rules evaluation error (surfaces to the
      // client as "Missing or insufficient permissions"), not a clean
      // "not found". This is exactly the get-before-create pattern
      // getOrCreatePersonalConversation uses (checks whether a
      // personal_{sorted uid pair} doc already exists before creating it)
      // — the most common trigger is literally the FIRST-EVER contact
      // between any two users. Allowing resource==null leaks nothing (no
      // data exists on a nonexistent doc) beyond confirming a deterministic
      // doc id's existence, which is unavoidable in any get-then-create flow.
      allow read: if signedIn() && (resource == null || canReadConversation(resource.data));
      allow create: if signedIn() && canCreateConversation(request.resource.data);
      allow update: if signedIn() && canUpdateConversation(resource.data, request.resource.data);
    }

    // ── CONVERSATION META ── (per-user sidebar/inbox index, owner-only)
    match /conversationMeta/{uid}/conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── MESSAGES ──
    // orgId isn't a field on the message doc itself (see functions/ai.js /
    // vendor/ai-foundation, which key off conversationId + senderUid/senderOrgId
    // only) — tenant isolation is enforced entirely via the parent conversation.
    match /messages/{messageId} {
      // Branches on the PARENT conversation's `context` (see canReadMessage /
      // canCreateMessage below) — personal-context threads read/send on
      // thread participation alone; the pre-accept one-way gate (only the
      // conversation's createdBy may write while status == 'requested') is
      // enforced here, not just client-side. organization-context and
      // un-backfilled legacy (context == null) docs keep the original
      // isActiveMember + canAccessConversation check, unchanged.
      allow read: if signedIn()
        && canReadMessage(get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && canCreateMessage(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data);
      allow update, delete: if false;
    }
    // ══ END TENANCY ═════════════════════════════════════════

    // ══ AI FOUNDATION LAYER — PHASE 1 ═══════════════════════
    // suggestedActions/ledgerEntries/milestones/snags — Cloud
    // Functions/Admin SDK only write; client read stays gated on
    // conversation participancy via isConversationParticipant().

    // ownerUid (additive, Phase 1 identity-first): the person-owned
    // counterpart to orgId, set only on personal-context (1:1) records by
    // routeAIOutput() in functions/ai.js — never both set on the same doc.
    // Every write path to these four collections is `allow write: if false`
    // unconditionally (Admin SDK only, confirmSuggestedAction/onMessageCreate)
    // — a client can never set ownerUid (or orgId) on any doc here, org- or
    // personal-context, so this OR-branch can't be used to self-grant read
    // access to another party's record.

    // ── SUGGESTED ACTIONS ── (Cloud Functions/Admin SDK only write)
    // Tightened (Phase D, preserved): conversation participancy alone is not
    // enough for an org-context record — a counterparty not a member of the
    // doc's own org must not see that side's suggestion chips.
    match /suggestedActions/{actionId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }

    // ── LEDGER ENTRIES / MILESTONES / SNAGS ── (Cloud Functions/Admin SDK only write)
    // Same per-org privacy as suggestedActions above — confirmed business
    // records stay private to the org they belong to.
    match /ledgerEntries/{entryId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }
    match /milestones/{milestoneId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }
    match /snags/{snagId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }
    // ══ END AI FOUNDATION LAYER ═════════════════════════════

    // ══ BUSINESS OBJECTS — PHASE 1 FOUNDATION (additive, parallel) ══
    // docs/BUSINESS_OBJECTS_CONTRACT.md is the design source of truth. This
    // block is additive and parallel to the AI FOUNDATION LAYER block above
    // — suggestedActions/ledgerEntries/milestones/snags and their existing
    // rules are untouched. Nothing writes businessObjects yet in this slice
    // (Admin SDK only, once wired — same discipline as the collections
    // above); allow write: if false unconditionally, no exceptions.
    match /businessObjects/{objectId} {
      // resource == null guarded first — same standing pattern as the
      // conversations read rule fix (get() on a nonexistent doc must return
      // not-found, not crash rule evaluation by dereferencing resource.data
      // on a null resource).
      allow read: if request.auth != null
        && (resource == null || canReadBusinessObject(resource.data));
      allow write: if false;
    }

    // Every check reads scopeTags via .get(key, default) rather than dot
    // access, guarding a doc whose scopeTags map (or a key within it) is
    // absent — same defensive idiom as canReadMessage's
    // convData.get('context', null) above. All four are cheap: no more than
    // one membership get() (isActiveMember) or one store get() (isStoreOwner)
    // is evaluated, and only if its own null-guard already passed.
    //
    // participantUids is gated OUT for type == 'ledger_entry': a ledger is
    // private books, not shared two-party truth, so a personal-origin ledger
    // object is readable by its ownerUid only — the other 1:1 participant is
    // NOT granted read via participantUids for this type. participantUids
    // stays on scopeTags (see contract doc) for future shared object types
    // (e.g. commitments) where both parties SHOULD read the same record; the
    // per-type branch below is exactly where that future type's grant goes.
    function canReadBusinessObject(data) {
      let tags = data.get('scopeTags', {});
      return tags.get('ownerUid', null) == request.auth.uid
        || (data.get('type', null) != 'ledger_entry' && request.auth.uid in tags.get('participantUids', []))
        || (tags.get('orgId', null) != null && isActiveMember(tags.orgId))
        || (tags.get('storeId', null) != null && isStoreOwner(tags.storeId, request.auth.uid));
    }

    // Intentional placeholder, not a stopgap (see BUSINESS_OBJECTS_CONTRACT.md
    // "Design decisions"): there is no store-membership concept anywhere in this
    // schema — match /stores/{storeId} is `allow read: if true`, scoped on
    // write only by a single contributorId, not a multi-user membership
    // list. This reflects today's real-world shape (single-owner retailers)
    // and reuses that one existing relationship as "linked to the store."
    // Extend with a real membership check once multi-user stores exist —
    // not built here per explicit scope decision.
    function isStoreOwner(storeId, uid) {
      return exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.contributorId == uid;
    }
    // ══ END BUSINESS OBJECTS ═════════════════════════════════

    // ══ HOM SYSTEMS — "HOUSE OF MOD" — BLOCK 1 (additive, parallel) ══
    // Kitchen-shutter microsite: editable catalog + vendor directory +
    // customer orders + supplier purchase orders. Every write below is
    // gated on isAdmin() (the same single-email check every other
    // admin-only collection in this file already uses) — TODO(hom_admin):
    // a dedicated scoped hom_admin role lands in Block 3; swap isAdmin()
    // for it on every line marked below, no other logic changes.

    // ── CATALOG ── (profiles/colours/glasses/addons/bars/rates — one doc)
    // Public read: the microsite renders pricing with no auth at all.
    match /homConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin(); // TODO(hom_admin): scope to hom_admin role
    }

    // ── VENDORS ── (installer/fabricator directory — admin-managed only)
    match /homVendors/{vendorId} {
      allow read, write: if isAdmin(); // TODO(hom_admin): scope to hom_admin role
    }

    // ── ORDERS ── (customer-submitted quote/order requests)
    // Public create, gated on full-shape validation (isValidHomOrder) — the
    // microsite has no auth, so anyone can submit an order, but only a
    // well-formed one with real customer contact info, a real pincode, at
    // least one cabinet, a pricing snapshot, and a recognized payment
    // method. Read/delete stay admin-only: an unauthenticated customer has
    // no uid to scope a read to, so they can't read even their own
    // just-created order back — let alone another customer's.
    match /homOrders/{orderId} {
      allow create: if isValidHomOrder(request.resource.data);
      // BLOCK 2 (additive to Block 1): the microsite uploads reference
      // attachments to Storage AFTER the order doc already exists (it needs
      // the real orderId as the storage path), so it must come back and
      // patch attachments[] onto its own just-created doc — but it's still
      // unauthenticated, so there is no uid to scope this to the actual
      // creator. Narrowed instead by what the update can touch and when:
      // ONLY the attachments key (diff().affectedKeys().hasOnly, per the
      // project's standing write-scoping convention — see jobListings/
      // jobApplications above), and ONLY the single transition from empty
      // to populated (resource.data.get('attachments', []).size() == 0) —
      // so this path can set attachments exactly once per order and can
      // never be used to touch pricing/status/customer data on anyone's
      // order, its own included.
      allow update: if isAdmin()
        || (
          resource != null
          && resource.data.get('attachments', []).size() == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments'])
          && request.resource.data.attachments is list
        );
      allow read, delete: if isAdmin(); // TODO(hom_admin): scope to hom_admin role
    }

    // ── SUPPLIER ORDERS ── (admin's own purchase orders to profile/glass suppliers)
    match /homSupplierOrders/{docId} {
      allow read, write: if isAdmin(); // TODO(hom_admin): scope to hom_admin role
    }

    // .get(key, default) throughout — same defensive idiom as
    // canReadBusinessObject above — a client-submitted request.resource.data
    // may simply omit a key instead of sending it null, and bare dot-access
    // on an absent map key throws a rules evaluation error instead of
    // failing validation cleanly.
    function isValidHomOrder(data) {
      let customer = data.get('customer', null);
      return customer is map
        && customer.get('name', '') is string && customer.name.size() > 0
        && customer.get('phone', '') is string && customer.phone.size() > 0
        && customer.get('pincode', '') is string && customer.pincode.matches('^[0-9]{6}$')
        && data.get('cabinets', []) is list && data.cabinets.size() > 0
        && data.get('pricingSnapshot', null) is map
        && data.get('paymentMethod', '') in ['online', 'cod'];
    }
    // ══ END HOM SYSTEMS — BLOCK 1 ═══════════════════════════════

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "enayathsheik@gmail.com";
    }

    function isConversationParticipant(conversationId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
    }

    // ── AI RECORD ACCESS (org OR personal ownerUid) ──
    function canReadAiRecord(data) {
      return (data.orgId != null && isActiveMember(data.orgId))
        || (data.ownerUid != null && data.ownerUid == request.auth.uid);
    }

    // ── CONVERSATION ACCESS — CONTEXT-BASED (Phase 1) ──
    // `.get('context', null)` — NOT bare `.context` — everywhere below: a
    // real un-backfilled doc has no `context` KEY at all (absent, not
    // explicitly null), and bare dot-access on a genuinely absent map key
    // throws a rules evaluation error ("Property context is undefined on
    // object") instead of returning null, which would break every read of
    // every pre-Phase-1 doc until the backfill runs. .get(key, default) is
    // the safe accessor for a key that may not exist at all.
    function canReadConversation(data) {
      return data.get('context', null) == 'personal'
        ? request.auth.uid in data.participantUids
        : data.get('context', null) == 'organization'
          ? (isActiveMember(data.orgId) && canAccessOrgConversation(data))
          : legacyCanReadConversation(data); // context==null
    }

    // Byte-identical to the pre-Phase-1 top-level read predicate, which gave
    // scope=='external' its OWN branch — signedIn() + participancy only, no
    // isActiveMember(orgId) at all (that bypass was the entire point of
    // Phase D). A uniform `isActiveMember(orgId) && canAccessConversation()`
    // fallback would silently re-impose the org-membership requirement Phase
    // D removed for every un-backfilled external-scope doc — this exists
    // specifically to not do that.
    function legacyCanReadConversation(data) {
      return data.scope == 'external'
        ? request.auth.uid in data.participantUids
        : (isActiveMember(data.orgId) && canAccessConversation(data));
    }

    function canCreateConversation(data) {
      return data.get('context', null) == 'personal'
        ? canCreatePersonalConversation(data)
        : (data.get('context', null) == 'organization' && canCreateOrgConversation(data));
    }

    function canUpdateConversation(before, after) {
      return before.get('context', null) == 'personal'
        ? canUpdatePersonalConversation(before, after)
        // organization AND legacy (context==null) both use the identical,
        // unchanged update predicate that applied unconditionally before
        // this deploy.
        : canUpdateOrgConversation(before, after);
    }

    // scope == 'org': every call site above already requires
    // isActiveMember(data.orgId) before reaching here, so no further check
    // is needed — matches the original canAccessConversation's
    // `data.scope == 'org' && isActiveMember(...)` exactly.
    function canAccessOrgConversation(data) {
      return data.scope == 'team'
        ? (request.auth.uid in data.participantUids ||
            (data.teamId != null && data.teamId in member(data.orgId).teamIds))
        : true;
    }

    // 1:1 personal create: exactly the creator + one named counterparty (no
    // third-party uid injection). Cross-org / no-shared-org: born
    // status:'requested' — the one-way pre-accept gate. Same-org exemption:
    // may be born status:'accepted' directly IF `sharedOrgId` names an org
    // both participants are genuinely, currently active members of — proven
    // here via real get() lookups, never taken on the client's word (see
    // bothActiveMembersOf). Group personal create: no accept-gate in
    // Phase 1, always born status:'accepted'.
    function canCreatePersonalConversation(data) {
      return data.createdBy == request.auth.uid
        && request.auth.uid in data.participantUids
        && (
          (data.type == 'direct'
            && data.participantUids.size() == 2
            && (
              data.status == 'requested'
              || (data.status == 'accepted'
                  && data.sharedOrgId != null
                  && bothActiveMembersOf(data.sharedOrgId, data.participantUids))
            ))
          || (data.type == 'group' && data.status == 'accepted')
        );
    }

    // Parameterized sibling of isActiveMember(orgId) (which is always
    // implicitly for request.auth.uid) — used only by the same-org
    // accept-gate exemption above, to check an arbitrary OTHER participant's
    // membership. get()/exists() in rules read the real document regardless
    // of whether the caller could independently read it via a client query,
    // so this can't be spoofed by a client claiming a shared org that isn't
    // real.
    function isActiveMemberOf(orgId, uid) {
      return exists(/databases/$(database)/documents/memberships/$(orgId + '_' + uid))
        && get(/databases/$(database)/documents/memberships/$(orgId + '_' + uid)).data.status == 'active';
    }

    function bothActiveMembersOf(orgId, uids) {
      return isActiveMemberOf(orgId, uids[0]) && isActiveMemberOf(orgId, uids[1]);
    }

    // Identical to the pre-Phase-1 conversation create rule (minus the
    // scope != 'external' guard, now redundant since external is subsumed
    // into context == 'personal' and can never reach this branch) — zero
    // regression for organization-context creates.
    function canCreateOrgConversation(data) {
      return isActiveMember(data.orgId)
        && data.createdBy == request.auth.uid
        && request.auth.uid in data.participantUids
        && (data.scope != 'org' || hasRole(data.orgId, ['owner', 'admin', 'manager']));
    }

    // lastMessageAt: mirrors sendMessage's batch update, gated to whoever can
    // currently write messages (accepted, or the pre-accept initiator).
    // linkedEntities: mirrors linkEntity(), open to either participant
    // regardless of accept state. status: only the non-creator participant
    // may flip 'requested' -> 'accepted' — the recipient accepting, never
    // the initiator self-accepting.
    function canUpdatePersonalConversation(before, after) {
      return request.auth.uid in before.participantUids
        && (
          (after.diff(before).affectedKeys().hasOnly(['lastMessageAt'])
            && (before.status == 'accepted' || request.auth.uid == before.createdBy))
          || after.diff(before).affectedKeys().hasOnly(['linkedEntities'])
          || (after.diff(before).affectedKeys().hasOnly(['status'])
            && before.type == 'direct'
            && before.status == 'requested'
            && after.status == 'accepted'
            && request.auth.uid != before.createdBy)
        );
    }

    // Identical to the pre-Phase-1 update rule, which applied unconditionally
    // to every conversation before this deploy — kept byte-identical for both
    // context=='organization' and legacy (context==null) docs. Zero regression.
    function canUpdateOrgConversation(before, after) {
      return (request.auth.uid in before.participantUids || hasRole(before.orgId, ['owner', 'admin']))
        && (after.scope == before.scope || hasRole(before.orgId, ['owner', 'admin', 'manager']));
    }

    // ── MESSAGE ACCESS — CONTEXT-BASED (Phase 1) ──
    // convData is an already-fetched parent conversation's .data (callers
    // pass the result of a single get(), never re-fetched here). Same
    // `.get('context', null)` safety as canReadConversation above — a real
    // un-backfilled conversation doc has no `context` key at all.
    function canReadMessage(convData) {
      return convData.get('context', null) == 'personal'
        ? request.auth.uid in convData.participantUids
        : convData.get('context', null) == 'organization'
          ? (isActiveMember(convData.orgId) && canAccessOrgConversation(convData))
          : legacyCanReadConversation(convData); // context==null — same external-scope bypass as canReadConversation
    }

    // Pre-accept one-way gate: only the conversation's createdBy may write
    // while status == 'requested'; once accepted, either participant may.
    function canCreateMessage(convData) {
      return convData.get('context', null) == 'personal'
        ? (request.auth.uid in convData.participantUids
            && (convData.status == 'accepted' || request.auth.uid == convData.createdBy))
        : convData.get('context', null) == 'organization'
          ? (isActiveMember(convData.orgId) && canAccessOrgConversation(convData))
          : legacyCanCreateMessage(convData); // context==null
    }

    // Byte-identical to the pre-Phase-1 canCreateMessage: scope=='external'
    // bypasses isActiveMember(orgId) (same rationale as
    // legacyCanReadConversation) AND additionally requires the message's
    // own senderOrgId be one of the parent's participantOrgIds — a sender in
    // a legacy external thread can only stamp their own side's org onto a
    // message, never the counterparty's. request.resource.data is available
    // directly here (it's the document actually being created), same as
    // every other function in this ruleset reaches request.auth directly.
    function legacyCanCreateMessage(convData) {
      return convData.scope == 'external'
        ? (request.auth.uid in convData.participantUids
            && request.resource.data.senderOrgId in convData.participantOrgIds)
        : (isActiveMember(convData.orgId) && canAccessConversation(convData));
    }

    // ── TENANCY HELPERS ──
    function signedIn() {
      return request.auth != null;
    }

    function mId(orgId) {
      return orgId + '_' + request.auth.uid;
    }

    function hasMembership(orgId) {
      return exists(/databases/$(database)/documents/memberships/$(mId(orgId)));
    }

    function member(orgId) {
      return get(/databases/$(database)/documents/memberships/$(mId(orgId))).data;
    }

    function isActiveMember(orgId) {
      return hasMembership(orgId) && member(orgId).status == 'active';
    }

    function hasRole(orgId, roles) {
      return isActiveMember(orgId) && member(orgId).role in roles;
    }

    // LEGACY (context==null docs only) — reached exclusively via the
    // context==null fallback branches above; left byte-identical to its
    // pre-Phase-1 form so an un-backfilled doc's behavior never changes.
    // participantUids doubles as the field name spec'd as "participants" —
    // kept as participantUids so functions/vendor/ai-foundation's context
    // builder (which reads conversation.participantUids) keeps working.
    function canAccessConversation(data) {
      return
        (data.scope == 'personal' && request.auth.uid in data.participantUids) ||
        (data.scope == 'team' && (request.auth.uid in data.participantUids ||
          (data.teamId != null && data.teamId in member(data.orgId).teamIds))) ||
        (data.scope == 'org' && isActiveMember(data.orgId)) ||
        (data.scope == 'external' && request.auth.uid in data.participantUids);
    }
  }
}
