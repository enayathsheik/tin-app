rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────
    match /users/{userId} {
      // Own account, or the TIN super admin (Admin → TIN Jobs Admin).
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      // verificationStatus decides whether a user's jobs carry the "verified
      // business" badge, storeId which store page their jobs show on, and
      // postingBlocked stops them posting — so only the admin may set them
      // (Jobs redesign phase 3). `role` is self-chosen, but
      // only from the ordinary account types: hom_admin opens HOM Systems
      // (isHomAdminRole() below), so only the admin may give it out (S0). An
      // account that already has another role keeps it on ordinary saves.
      // Everything else on the doc stays self-editable exactly as before.
      function selfRoleOk() {
        return isAdmin() || request.resource.data.get("role", "consumer") in
          ["consumer", "contributor", "retailer", "contractor", "architect", "manufacturer", "jobseeker", "employer"];
      }
      // The admin may create one only to block an account that has no record.
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(["postingBlocked", "postingBlockedReason", "postingBlockedAt"]);
      allow create: if request.auth != null && request.auth.uid == userId
        && selfRoleOk()
        && request.resource.data.get("verificationStatus", "pending") in ["pending", "unverified"]
        && request.resource.data.get("storeId", null) == null
        && !request.resource.data.keys().hasAny(["postingBlocked", "postingBlockedReason", "postingBlockedAt"]);
      // Self-setting verificationStatus is allowed only to "pending" /
      // "unverified" (older RetailerDashboard builds re-save it as "pending")
      // — never to "verified".
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["storeId", "postingBlocked", "postingBlockedReason", "postingBlockedAt"])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]) || selfRoleOk())
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["verificationStatus"])
                || request.resource.data.get("verificationStatus", "") in ["pending", "unverified"]));
      allow delete: if isAdmin();

      // ── SAVED JOBS ── (Jobs redesign phase 2, see docs/JOBS_BLUEPRINT.md §5.1)
      match /savedJobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── STATS ──
      match /stats/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── CONTACTS ──
      match /contacts/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── SCHEDULE ──
      match /schedule/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── VISITS ──
      match /visits/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // ── LEAVE ──
      match /leave/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }
    }

    // ── STORES ─────────────────────────────────────────────
    match /stores/{storeId} {
      allow read: if true;
      // Only the admin sets a store's verified badge (verificationStatus /
      // verifiedAt / verifiedBy). Anyone signed in may add a store, but it
      // starts unverified ("community_added" or unset).
      allow create: if isAdmin()
        || (request.auth != null
            && request.resource.data.get("verificationStatus", "community_added") == "community_added"
            && request.resource.data.get("verifiedAt", null) == null
            && request.resource.data.get("verifiedBy", null) == null
            && !request.resource.data.keys().hasAny(storeClaimKeys()));
      // Whoever added the store may still edit its normal details, but not
      // its verification fields or who it belongs to (contributorId).
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.get("contributorId", "") == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(["verificationStatus", "verifiedAt", "verifiedBy", "contributorId"])
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(storeClaimKeys()));
      allow delete: if isAdmin();
    }
    // L2b: set only by the admin when approving a claim (src/lib/storeClaims.js
    // approveClaim). claimedByUid makes an imported store public
    // (src/utils/storeVisibility.js), so nobody else may set it.
    function storeClaimKeys() {
      return ["claimedByUid", "claimedAt", "claimId", "previousContributorId"];
    }

    // ── REPORTS ────────────────────────────────────────────
    match /reports/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── CLAIMS ─────────────────────────────────────────────
    // L2b "Find your business": a signed-in user claims a store for their own
    // account only, with a confirmed mobile number (GST optional). The admin
    // approves or rejects (src/lib/storeClaims.js); the claimant can read their
    // own claims to see the status.
    match /claims/{docId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.get("claimantUid", "") == request.auth.uid);
      allow create: if request.auth != null && isValidNewClaim();
      allow update, delete: if isAdmin();
    }
    function isValidNewClaim() {
      let d = request.resource.data;
      let storePath = /databases/$(database)/documents/stores/$(d.storeId);
      return d.keys().hasOnly(["claimantUid", "storeId", "storeName", "storeCity", "name",
                               "phone", "phoneConfirmed", "gst", "email", "status", "createdAt"])
        && d.claimantUid == request.auth.uid
        && d.status == "pending"
        && d.storeId is string
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.matches("^[6-9][0-9]{9}$")
        && d.phoneConfirmed == true
        && (d.get("gst", null) == null || (d.gst is string && d.gst.size() == 15))
        && d.createdAt == request.time
        && exists(storePath)
        && get(storePath).data.get("claimedByUid", null) == null;
    }

    // ── SUGGESTIONS ────────────────────────────────────────
    match /suggestions/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── CUSTOM CATEGORIES ──────────────────────────────────
    match /customCategories/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── ADMIN ONLY ─────────────────────────────────────────
    match /adminData/{docId} {
      allow read, write: if isAdmin();
    }

    // ── HELPER ─────────────────────────────────────────────
    // ── STAGED STORES ──────────────────────────────────────
    match /staged_stores/{docId} {
      allow read, write: if isAdmin();
    }
    // ── PULL JOBS ──────────────────────────────────────────
    match /pull_jobs/{docId} {
      allow read, write: if isAdmin();
    }
    // ── CONTRIBUTORS ───────────────────────────────────────
    match /contributors/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── INSPI POSTS ──────────────────────────────────────────
    match /inspiPosts/{postId} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    // ══ NEW: JOB LISTINGS ═══════════════════════════════════
    // Public read only shows approved listings; the poster can also always
    // see their own (pending / taken down) listing. Every new job goes live at
    // once (owner decision for beta); the admin checks afterwards and can take
    // it down. Only an account that is really verified may say
    // verified_business. "pending" is still accepted from older open pages.
    match /jobListings/{jobId} {
      allow read: if isAdmin()
        || (resource != null && (
             resource.data.get("status", "") == "approved"
          || (request.auth != null && resource.data.get("postedByUid", "") == request.auth.uid)));
      allow create: if request.auth != null
        && request.resource.data.get("postedByUid", "") == request.auth.uid
        && (
          request.resource.data.get("status", "") == "pending"
          || (request.resource.data.get("status", "") == "approved" && request.resource.data.get("jobStatus", "") == "live")
        )
        && request.resource.data.get("createdAt", null) == request.time // newest-first lists can't be gamed
        && (request.resource.data.get("postedByType", "individual") == "individual"
            || (request.resource.data.get("postedByType", "") == "verified_business" && jobPosterIsVerified()))
        && !request.resource.data.keys().hasAny(["takedown"])
        && !postingBlocked()
        && jobFieldsOk(request.resource.data)
        && jobPayRangeOk(request.resource.data)
        && request.resource.data.get("shortlistCount", 0) == 0 // L10
        && jobStoreIdOk(request.resource.data);
      // Jobs redesign phase 3 (docs/JOBS_BLUEPRINT.md §5.3): the poster may
      // edit the content of their own listing and flip jobStatus; edits stay
      // live. Moderation is admin-only: the poster can never change status, so
      // a taken-down job stays down. A blocked account can still pause or
      // close its jobs, but not edit or reopen them.
      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.get("postedByUid", "") == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "jobStatus", "updatedAt",
               "jobTitle", "description", "city", "state", "pincode", "businessName",
               "contactPhone", "category", "jobType", "salaryRange", "notAgencyDeclaration",
               "lane", "trade", "functions", "workTypes", "headcount", "experience",
               "education", "workingHours", "responsibilities", "skills",
               "shortAssignment", "pay", "benefits", "evpText", "industry", "storeId", "shortlistCount"])
          // "paused" (phase 5a, Employer Desk): hidden from the public feed
          // and closed to new applications (both require "live").
          && request.resource.data.get("jobStatus", "live") in ["live", "paused", "filled", "closed"]
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(["jobStatus", "updatedAt", "shortlistCount"])
               && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["jobStatus"])
                   || request.resource.data.get("jobStatus", "") != "live"))
              || !postingBlocked())
          // L10: the shortlist counter only goes up, never past the limit.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["shortlistCount"])
              || (request.resource.data.get("shortlistCount", 0) is int
                  && request.resource.data.get("shortlistCount", 0) > resource.data.get("shortlistCount", 0)
                  && request.resource.data.get("shortlistCount", 0) <= shortlistLimit()))
          && jobFieldsOk(request.resource.data)
          // L7: old jobs keep their pay as-is; an edit that changes pay needs a range.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["pay"])
              || jobPayRangeOk(request.resource.data))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["storeId"])
              || jobStoreIdOk(request.resource.data))
        );
      allow delete: if isAdmin();

      // ── L10: shortlist slots ──
      // Every applicant shortlisted for the first time (the moment phone,
      // email and CV unlock — L8) takes one numbered slot 1..limit (beta
      // mode: no limit, but slots are still recorded), in the same
      // batch as that application's stage change and the job's shortlistCount.
      // Doc ids are unique, so at most `limit` applicants per job can ever be
      // unlocked; rejecting, moving or closing never frees a slot.
      match /shortlistSlots/{slot} {
        allow read: if request.auth != null
          && (isAdmin() || get(/databases/$(database)/documents/jobListings/$(jobId)).data.get("postedByUid", "") == request.auth.uid);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/jobListings/$(jobId)).data.get("postedByUid", "") == request.auth.uid
          && slot.matches("^[1-9][0-9]{0,5}$")
          && int(slot) <= shortlistLimit()
          && int(slot) > get(/databases/$(database)/documents/jobListings/$(jobId)).data.get("shortlistCount", 0)
          && int(slot) <= getAfter(/databases/$(database)/documents/jobListings/$(jobId)).data.get("shortlistCount", 0)
          && request.resource.data.keys().hasOnly(["appId", "createdAt"])
          && getAfter(/databases/$(database)/documents/jobApplications/$(request.resource.data.get("appId", "_"))).data.get("jobId", "") == jobId
          && getAfter(/databases/$(database)/documents/jobApplications/$(request.resource.data.get("appId", "_"))).data.get("shortlistSlot", 0) == int(slot);
        allow update, delete: if isAdmin();
      }

      function postingBlocked() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("postingBlocked", false) == true;
      }
      function jobPosterIsVerified() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("verificationStatus", "") == "verified";
      }
      // Lane / headcount sanity, and hidden pay ("Negotiable" / "Don't
      // disclose") must not carry amounts — job docs are publicly readable.
      function jobFieldsOk(data) {
        return data.get("lane", "professional") in ["professional", "skilled"]
          && data.get("headcount", 1) is int
          && data.get("headcount", 1) >= 1
          && (!(data.get("pay", {}).get("display", "") in ["negotiable", "undisclosed"])
              || (data.get("pay", {}).get("min", null) == null && data.get("pay", {}).get("max", null) == null));
      }
      // L7 (launch): every new job shows a pay range — period + from/to, no
      // "Don't disclose"; "Negotiable" is an optional flag shown next to it.
      function jobPayRangeOk(data) {
        let p = data.get("pay", null);
        return p is map
          && p.get("display", "") == "show_range"
          && p.get("period", "") in ["month", "year", "day", "hour", "project"]
          && p.get("min", null) is number && p.get("min", 0) > 0
          && p.get("max", null) is number && p.get("max", 0) >= p.get("min", 0)
          && p.get("negotiable", false) is bool;
      }
      // A job may carry a storeId only if it's the poster's admin-set store link.
      function jobStoreIdOk(data) {
        return data.get("storeId", null) == null
          || data.get("storeId", null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("storeId", "__no_linked_store__");
      }
    }

    // ══ NEW: JOB APPLICATIONS ═══════════════════════════════
    // Read restricted to the applicant themselves or the poster of the
    // job being applied to (looked up via the application's jobId).
    match /jobApplications/{applicationId} {
      // Jobs redesign phase 4 (docs/JOBS_BLUEPRINT.md §5.5/§5.6).
      // Document ID is deterministic (`${jobId}_${applicantUid}`) — !exists() blocks
      // a second apply attempt at the rules layer, not just the UI. The job
      // must exist and be approved + live, and not be the applicant's own.
      // Old clients (no stage, applicantStatus "new") still pass during rollout.
      allow create: if request.auth != null
        && request.resource.data.get("applicantUid", "") == request.auth.uid
        && applicationId == request.resource.data.get("jobId", "") + "_" + request.auth.uid
        && !exists(/databases/$(database)/documents/jobApplications/$(applicationId))
        && exists(/databases/$(database)/documents/jobListings/$(request.resource.data.get("jobId", "")))
        && get(/databases/$(database)/documents/jobListings/$(request.resource.data.get("jobId", ""))).data.get("status", "") == "approved"
        && get(/databases/$(database)/documents/jobListings/$(request.resource.data.get("jobId", ""))).data.get("jobStatus", "") == "live"
        && get(/databases/$(database)/documents/jobListings/$(request.resource.data.get("jobId", ""))).data.get("postedByUid", "") != request.auth.uid
        && request.resource.data.get("stage", "submitted") == "submitted"
        && request.resource.data.get("applicantStatus", "new") == "new"
        && request.resource.data.get("stageHistory", []).size() <= 1
        // L8: phone, email and CV go in private/contact (below), never on the
        // application the employer can read; pay only if the candidate chose
        // to show it; contact can't start unlocked.
        && !request.resource.data.keys().hasAny(["applicantPhone", "applicantEmail", "resumePath", "resumeUrl", "resumeFileName", "contactUnlockedAt", "shortlistSlot", "source"])
        && (request.resource.data.get("payVisible", false) == true
            || !request.resource.data.keys().hasAny(["currentPay", "expectedPay"]))
        && request.resource.data.get("hasCv", false) is bool;
      // resource != null (not "== null ||"): ids are {jobId}_{uid}, so a
      // missing application must stay "denied", not reveal who applied.
      allow read: if isAdmin()
        || (request.auth != null && resource != null
            && (resource.data.get("applicantUid", "") == request.auth.uid
                || managesJob(resource.data.get("jobId", ""))));
      allow update: if isAdmin() || (request.auth != null && !(appStage(resource.data) in ["not_shortlisted", "offer_accepted", "offer_declined", "not_selected", "withdrawn", "closed", "hired"]) && (
        // ── Candidate: withdraw; accept an interview (only from invited /
        //    rescheduled); answer an offer (only from offer_sent); or send a
        //    reschedule note without changing the stage.
        (resource.data.get("applicantUid", "") == request.auth.uid
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["interviewResponse", "updatedAt"])
              && appStage(resource.data) in ["int_invited", "int_rescheduled"])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage", "stageHistory", "updatedAt", "interviewResponse"])
              && stageHistoryGrewByOne()
              && (request.resource.data.get("stage", "") == "withdrawn"
                  || (request.resource.data.get("stage", "") == "int_scheduled"
                      && appStage(resource.data) in ["int_invited", "int_rescheduled"])
                  || (request.resource.data.get("stage", "") in ["offer_accepted", "offer_declined"]
                      && appStage(resource.data) == "offer_sent")))
          ))
        ||
        // ── Employer (poster of the job): employer stages only, timeline
        //    grows by one. Older My Jobs builds that only change
        //    applicantStatus keep working.
        (managesJob(resource.data.get("jobId", ""))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicantStatus", "stage", "stageHistory", "updatedAt", "interview", "contactUnlockedAt", "shortlistSlot"])
          && contactUnlockOk()
          // Old builds that only change applicantStatus may only reject — a
          // shortlist must go through the stage path so contact unlock is
          // recorded (L8).
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicantStatus"])
               && request.resource.data.get("applicantStatus", "") == "rejected")
              || (request.resource.data.get("stage", "") in ["review", "shortlisted", "not_shortlisted", "contacted", "int_done", "info_req", "assess_req", "selected", "offer_sent", "not_selected", "closed", "app_viewed", "profile_viewed", "int_invited", "int_rescheduled"]
                  && stageHistoryGrewByOne())
              // "Mark as hired": only someone already selected or offered.
              || (request.resource.data.get("stage", "") == "hired"
                  && appStage(resource.data) in ["selected", "offer_sent"]
                  && stageHistoryGrewByOne())))
      ));

      // The job's poster — but not while TIN has taken the job down: that ends
      // their access to its applications, contacts and CVs (storage.rules too)
      // until it's restored. ("rejected" = refused before beta.)
      function managesJob(jobId) {
        return isActivePoster(get(/databases/$(database)/documents/jobListings/$(jobId)).data);
      }
      function isActivePoster(j) {
        return j.get("postedByUid", "") == request.auth.uid
          && !(j.get("status", "") in ["taken_down", "rejected"]);
      }

      // ── L8: contact visibility ──
      // Phone, email and CV unlock for the job's manager (today: the poster;
      // admin always) when the application first reaches Shortlisted or a
      // later stage. contactUnlockedAt is set once, in that same write, and
      // never changes again — rejecting or closing later doesn't re-lock.
      function contactUnlockStages() {
        return ["shortlisted", "contacted", "int_invited", "int_scheduled", "int_rescheduled", "int_done",
                "info_req", "assess_req", "selected", "offer_sent", "offer_accepted", "offer_declined", "hired"];
      }
      // Applications from before L8 already past Shortlisted count as unlocked.
      function contactUnlocked(d) {
        return d.get("contactUnlockedAt", null) != null || appStage(d) in contactUnlockStages();
      }
      function contactUnlockOk() {
        return (request.resource.data.get("stage", "") in contactUnlockStages() && !contactUnlocked(resource.data))
          ? request.resource.data.get("contactUnlockedAt", null) == request.time
            && shortlistSlotOk()
          : !request.resource.data.diff(resource.data).affectedKeys().hasAny(["contactUnlockedAt", "shortlistSlot"]);
      }
      // L10: a first shortlist must take a slot created in the same batch.
      function shortlistSlotOk() {
        return request.resource.data.get("shortlistSlot", 0) is int
          && existsAfter(/databases/$(database)/documents/jobListings/$(resource.data.get("jobId", ""))/shortlistSlots/$(string(request.resource.data.get("shortlistSlot", 0))))
          && getAfter(/databases/$(database)/documents/jobListings/$(resource.data.get("jobId", ""))/shortlistSlots/$(string(request.resource.data.get("shortlistSlot", 0)))).data.get("appId", "") == applicationId;
      }

      // Private part: applicantPhone, applicantEmail, resumePath, resumeFileName.
      // Written by the applicant in the same batch as the application;
      // readable by the applicant, admin, and the job's poster once unlocked.
      match /private/{docId} {
        allow read: if isAdmin() || (request.auth != null && docId == "contact" && (
             get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.get("applicantUid", "") == request.auth.uid
          || (managesJob(get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.get("jobId", ""))
              && contactUnlocked(get(/databases/$(database)/documents/jobApplications/$(applicationId)).data))));
        allow create: if isAdmin() || (request.auth != null && docId == "contact"
          && getAfter(/databases/$(database)/documents/jobApplications/$(applicationId)).data.get("applicantUid", "") == request.auth.uid
          && request.resource.data.keys().hasOnly(["applicantPhone", "applicantEmail", "resumePath", "resumeFileName", "createdAt"])
          && (request.resource.data.get("resumePath", "") == ""
              || request.resource.data.get("resumePath", "").matches("resumes/" + request.auth.uid + "/"
                   + getAfter(/databases/$(database)/documents/jobApplications/$(applicationId)).data.get("jobId", "") + "/[^/]+")));
        allow update, delete: if isAdmin();
      }

      // Current stage: the new field, else the old applicantStatus through
      // the approved mapping (new→submitted, shortlisted, rejected→
      // not_shortlisted, hired→offer_accepted).
      function appStage(d) {
        return d.get("stage", "") != "" ? d.get("stage", "")
          : d.get("applicantStatus", "new") == "shortlisted" ? "shortlisted"
          : d.get("applicantStatus", "new") == "rejected" ? "not_shortlisted"
          : d.get("applicantStatus", "new") == "hired" ? "offer_accepted"
          : "submitted";
      }
      // Each stage change appends exactly one timeline entry for that stage.
      function stageHistoryGrewByOne() {
        return request.resource.data.get("stageHistory", []).size() == resource.data.get("stageHistory", []).size() + 1
          && request.resource.data.get("stageHistory", [])[request.resource.data.get("stageHistory", []).size() - 1].get("stage", "") == request.resource.data.get("stage", "");
      }
    }

    // ── CANDIDATE JOB PROFILES ── (Jobs redesign phase 4, §4.1 / §5.4)
    // Shareable part: owner writes; never carries private fields. Readable by
    // the owner, the admin, and — only once the person said yes to "Let
    // employers find and call me" and is looking (`searchable`) — by employer
    // accounts, 20 at a time (A1).
    match /jobProfiles/{uid} {
      // Account type is self-chosen, so this only keeps ordinary job seekers
      // from browsing each other. The phone, email and CV have their own gate.
      function isEmployerAccount() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && employerData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
      }
      function employerData(u) {
        return u.get("role", "") in ["retailer", "contractor", "architect", "manufacturer", "employer"]
          || u.get("storeId", null) != null
          || u.get("jobBusiness", null) != null;
      }
      function isSearchable() {
        return resource != null && resource.data.get("searchable", false) == true;
      }
      // `searchable` can never say yes without the consent and a "looking"
      // visibility (LOOKING in src/utils/candidateSearch.js).
      function searchFieldsOk() {
        return request.resource.data.get("openToEmployers", false) is bool
          && request.resource.data.get("searchable", false) == (
               request.resource.data.get("openToEmployers", false) == true
            && request.resource.data.get("visibility", "") in ["actively_looking", "open_to_opportunities", "freelance_project", "employed_open_suitable"])
          && request.resource.data.get("cityKey", "") is string
          && request.resource.data.get("cityKey", "").size() <= 80
          && request.resource.data.get("expBand", "") in ["", "0_1", "2_4", "5_9", "10_plus"];
      }
      allow get: if isAdmin() || (request.auth != null
        && (request.auth.uid == uid || (isSearchable() && isEmployerAccount())));
      allow list: if isAdmin() || (request.auth != null
        && isSearchable() && request.query.limit <= 20 && isEmployerAccount());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(["phone", "email", "currentPay", "expectedPay", "cv"])
        && request.resource.data.get("lane", "professional") in ["professional", "skilled"]
        && searchFieldsOk();
      // Launch tools backfill: the admin may fill these two, never the consent.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["cityKey", "expBand"])
        && searchFieldsOk();
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // Private part (phone, email, pay, CV details): the candidate, plus the
    // TIN super admin read-only (Admin → TIN Jobs Admin). Never employers.
    match /jobProfilesPrivate/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // AI profile helper rate-limit counters (§8): aiUsage/{uid} and
    // aiUsage/_global are written only by the suggestJobProfile Cloud
    // Function (Admin SDK, which bypasses rules). No client reads or writes,
    // not even the user's own counter or admin.
    match /aiUsage/{docId} {
      allow read, write: if false;
    }
    // ══ END NEW ═════════════════════════════════════════════

    // A2: how many people an employer shortlisted from search today. Written
    // only by the shortlistCandidate Cloud Function (Admin SDK).
    match /searchShortlistUsage/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }

    // ── JOB REPORTS ── (Jobs redesign phase 2, see docs/JOBS_BLUEPRINT.md §5.1)
    // One report per person per job (id = {jobId}_{uid}; a repeat is an
    // update, which only admin may do). Admin-only read: Admin → Jobs Review,
    // which marks them checked (checkedAt).
    match /jobReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.get("reporterUid", "") == request.auth.uid
        && reportId == request.resource.data.get("jobId", "") + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly(["jobId", "reporterUid", "reason", "createdAt"])
        && request.resource.data.get("reason", "") in ["scam", "asks_money", "misleading", "agency", "other"]
        && exists(/databases/$(database)/documents/jobListings/$(request.resource.data.get("jobId", "")));
      allow read, update, delete: if isAdmin();
    }

    // ── HANDLES (tinit ID) ─────────────────────────────────
    match /handles/{handle} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── PUBLIC PROFILES (tinit ID) ─────────────────────────
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ══ TENANCY — PHASE A ═══════════════════════════════════
    // Real org/membership model. organizations + conversations/messages
    // below supersede the admin-only scaffolding org and message docs
    // used to write; participantUids/participantOrgIds/senderUid/senderOrgId
    // are kept as-is on conversations/messages since functions/ai.js and
    // the vendored ai-foundation context builder read them by those exact
    // names — only orgId/scope/teamId/createdBy are new, additive fields.

    // ── ORGANIZATIONS ──
    match /organizations/{orgId} {
      // orgId == own uid is a user's deterministic solo-org slot (see
      // lib/tenancy.js createOrganization) — they must be able to read it,
      // to check whether they've bootstrapped it yet, before any
      // membership (and thus isActiveMember) exists.
      allow read: if isActiveMember(orgId) || (signedIn() && orgId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if hasRole(orgId, ['owner', 'admin']);
    }

    // ── MEMBERSHIPS ──
    match /memberships/{membershipId} {
      // The last clause lets a user always read their own deterministic
      // self-membership doc ({uid}_{uid}) even before it exists, so the
      // bootstrap self-check doesn't hit a null-resource rule error on a
      // nonexistent doc. Scoped to exactly their own id — no broader than
      // the existing uid == auth.uid read clause already grants once the
      // doc exists.
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || hasRole(resource.data.orgId, ['owner', 'admin', 'manager'])
          || membershipId == request.auth.uid + '_' + request.auth.uid);
      // Bootstrap: a user may self-grant 'owner' only on the org they just created.
      // Otherwise, only an existing owner/admin may create memberships (invites).
      allow create: if
        (request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.createdBy == request.auth.uid)
        || hasRole(request.resource.data.orgId, ['owner', 'admin']);
      allow update, delete: if hasRole(resource.data.orgId, ['owner', 'admin']);
    }

    // ── ORGANIZATION MEMBERSHIPS ── (legacy dev-test scaffolding, admin-only)
    match /organizationMemberships/{membershipId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── CONVERSATIONS ──
    // ══ IDENTITY-FIRST — PHASE 1 ═══════════════════════════════
    // `context` ('personal' | 'organization') is the auth discriminator,
    // additive alongside the pre-existing `type` (direct|group) and `scope`
    // (personal|team|org|external) fields, which keep their prior meaning —
    // `scope` becomes a sub-classifier under context=='organization' (org vs
    // team visibility) and denormalized/historical metadata under
    // context=='personal'; it is never consulted for personal-context auth.
    // A doc with no `context` field yet (context == null) is a pre-Phase-1
    // conversation awaiting the one-time backfill (see
    // functions/scripts/backfill-conversation-context.js) — every context==null
    // branch below falls back to exactly today's isActiveMember(orgId) +
    // canAccessConversation() check, unchanged, so an un-backfilled doc is
    // never more open than it was before this rules deploy. That fallback is
    // read-only insurance, removed only once a verified count of
    // context==null docs hits zero.
    match /conversations/{conversationId} {
      // resource == null (the doc doesn't exist) must be checked before
      // dereferencing resource.data — Firestore evaluates security rules on
      // get() reads of NON-existent documents too, and resource.data on a
      // null resource throws a rules evaluation error (surfaces to the
      // client as "Missing or insufficient permissions"), not a clean
      // "not found". This is exactly the get-before-create pattern
      // getOrCreatePersonalConversation uses (checks whether a
      // personal_{sorted uid pair} doc already exists before creating it)
      // — the most common trigger is literally the FIRST-EVER contact
      // between any two users. Allowing resource==null leaks nothing (no
      // data exists on a nonexistent doc) beyond confirming a deterministic
      // doc id's existence, which is unavoidable in any get-then-create flow.
      allow read: if signedIn() && (resource == null || canReadConversation(resource.data));
      allow create: if signedIn() && canCreateConversation(request.resource.data);
      allow update: if signedIn() && canUpdateConversation(resource.data, request.resource.data);
    }

    // ── CONVERSATION META ── (per-user sidebar/inbox index, owner-only)
    match /conversationMeta/{uid}/conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── MESSAGES ──
    // orgId isn't a field on the message doc itself (see functions/ai.js /
    // vendor/ai-foundation, which key off conversationId + senderUid/senderOrgId
    // only) — tenant isolation is enforced entirely via the parent conversation.
    match /messages/{messageId} {
      // Branches on the PARENT conversation's `context` (see canReadMessage /
      // canCreateMessage below) — personal-context threads read/send on
      // thread participation alone; the pre-accept one-way gate (only the
      // conversation's createdBy may write while status == 'requested') is
      // enforced here, not just client-side. organization-context and
      // un-backfilled legacy (context == null) docs keep the original
      // isActiveMember + canAccessConversation check, unchanged.
      allow read: if signedIn()
        && canReadMessage(get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && canCreateMessage(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data);
      allow update, delete: if false;
    }
    // ══ END TENANCY ═════════════════════════════════════════

    // ══ AI FOUNDATION LAYER — PHASE 1 ═══════════════════════
    // suggestedActions/ledgerEntries/milestones/snags — Cloud
    // Functions/Admin SDK only write; client read stays gated on
    // conversation participancy via isConversationParticipant().

    // ownerUid (additive, Phase 1 identity-first): the person-owned
    // counterpart to orgId, set only on personal-context (1:1) records by
    // routeAIOutput() in functions/ai.js — never both set on the same doc.
    // Every write path to these four collections is `allow write: if false`
    // unconditionally (Admin SDK only, confirmSuggestedAction/onMessageCreate)
    // — a client can never set ownerUid (or orgId) on any doc here, org- or
    // personal-context, so this OR-branch can't be used to self-grant read
    // access to another party's record.

    // ── SUGGESTED ACTIONS ── (Cloud Functions/Admin SDK only write)
    // Tightened (Phase D, preserved): conversation participancy alone is not
    // enough for an org-context record — a counterparty not a member of the
    // doc's own org must not see that side's suggestion chips.
    match /suggestedActions/{actionId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }

    // ── LEDGER ENTRIES / MILESTONES / SNAGS ── (Cloud Functions/Admin SDK only write)
    // Same per-org privacy as suggestedActions above — confirmed business
    // records stay private to the org they belong to.
    match /ledgerEntries/{entryId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }
    match /milestones/{milestoneId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }
    match /snags/{snagId} {
      allow read: if request.auth != null
        && isConversationParticipant(resource.data.conversationId)
        && canReadAiRecord(resource.data);
      allow write: if false;
    }
    // ══ END AI FOUNDATION LAYER ═════════════════════════════

    // ══ BUSINESS OBJECTS — PHASE 1 FOUNDATION (additive, parallel) ══
    // docs/BUSINESS_OBJECTS_CONTRACT.md is the design source of truth. This
    // block is additive and parallel to the AI FOUNDATION LAYER block above
    // — suggestedActions/ledgerEntries/milestones/snags and their existing
    // rules are untouched. Nothing writes businessObjects yet in this slice
    // (Admin SDK only, once wired — same discipline as the collections
    // above); allow write: if false unconditionally, no exceptions.
    match /businessObjects/{objectId} {
      // resource == null guarded first — same standing pattern as the
      // conversations read rule fix (get() on a nonexistent doc must return
      // not-found, not crash rule evaluation by dereferencing resource.data
      // on a null resource).
      allow read: if request.auth != null
        && (resource == null || canReadBusinessObject(resource.data));
      allow write: if false;
    }

    // Every check reads scopeTags via .get(key, default) rather than dot
    // access, guarding a doc whose scopeTags map (or a key within it) is
    // absent — same defensive idiom as canReadMessage's
    // convData.get('context', null) above. All four are cheap: no more than
    // one membership get() (isActiveMember) or one store get() (isStoreOwner)
    // is evaluated, and only if its own null-guard already passed.
    //
    // participantUids is gated OUT for type == 'ledger_entry': a ledger is
    // private books, not shared two-party truth, so a personal-origin ledger
    // object is readable by its ownerUid only — the other 1:1 participant is
    // NOT granted read via participantUids for this type. participantUids
    // stays on scopeTags (see contract doc) for future shared object types
    // (e.g. commitments) where both parties SHOULD read the same record; the
    // per-type branch below is exactly where that future type's grant goes.
    function canReadBusinessObject(data) {
      let tags = data.get('scopeTags', {});
      return tags.get('ownerUid', null) == request.auth.uid
        || (data.get('type', null) != 'ledger_entry' && request.auth.uid in tags.get('participantUids', []))
        || (tags.get('orgId', null) != null && isActiveMember(tags.orgId))
        || (tags.get('storeId', null) != null && isStoreOwner(tags.storeId, request.auth.uid));
    }

    // Intentional placeholder, not a stopgap (see BUSINESS_OBJECTS_CONTRACT.md
    // "Design decisions"): there is no store-membership concept anywhere in this
    // schema — match /stores/{storeId} is `allow read: if true`, scoped on
    // write only by a single contributorId, not a multi-user membership
    // list. This reflects today's real-world shape (single-owner retailers)
    // and reuses that one existing relationship as "linked to the store."
    // Extend with a real membership check once multi-user stores exist —
    // not built here per explicit scope decision.
    function isStoreOwner(storeId, uid) {
      return exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.contributorId == uid;
    }
    // ══ END BUSINESS OBJECTS ═════════════════════════════════

    // ══ HOM SYSTEMS — BLOCK 1 (additive, parallel) ══
    // Kitchen-shutter microsite: editable catalog + vendor directory +
    // customer orders + supplier purchase orders. Management writes are
    // gated on canManageHom() — full TIN admin (isAdmin()) OR the scoped
    // hom_admin role (isHomAdminRole(), Block 3) — see both functions below.

    // ── CATALOG ── (profiles/colours/glasses/addons/bars/rates — one doc)
    // Public read: the microsite renders pricing with no auth at all.
    match /homConfig/{docId} {
      allow read: if true;
      allow write: if canManageHom();
    }

    // ── VENDORS ── (installer/fabricator directory — admin-managed only)
    match /homVendors/{vendorId} {
      allow read, write: if canManageHom();
    }

    // ── ORDERS ── (customer-submitted quote/order requests)
    // Gated on full-shape validation (isValidHomOrder), a real customer
    // contact/pincode, at least one cabinet, a pricing snapshot, and a
    // recognized payment method. Delete stays isAdmin()-only, narrower than
    // the rest of this block on purpose — nothing in Block 3's hom_admin
    // workflow (approve/assign/advance status) ever deletes an order, so
    // there's no reason to hand out that capability.
    //
    // BLOCK 5 (additive to Blocks 1-4): browsing/cabinet-building on the
    // microsite stays fully anonymous — the login gate only appears at
    // "place order" (see src/pages/hom/HomBuilder.jsx) — but the create
    // itself now requires a signed-in TIN account (mobile or email, see
    // src/utils/phoneAuth.js) and stamps request.auth.uid onto the order as
    // ownerUid. This supersedes the earlier "the microsite has no auth"
    // read/write reasoning below — every order now has a real owner uid to
    // scope both a narrower attachments-update and an optional owner read
    // to. See test/rules/hom-payment.test.js and test/rules/hom.test.js for
    // the proof.
    //
    // BLOCK 4: status becomes "confirmed" either via a COD approval
    // (canManageHom() staff, below — see src/utils/homAdmin.js's
    // approveAndAssignOrder) or, in a future block, via a verified online
    // payment written server-side with the Admin SDK (bypasses these rules
    // entirely, as every Cloud Function write does) — online payment itself
    // is parked (TODO(block4-payment), no gateway wired up yet). Either
    // way, no client-writable path below can set status or paymentStatus at
    // all: the public branch is hard-scoped to
    // affectedKeys().hasOnly(['attachments']), and canManageHom() (the only
    // other write path) is restricted to trusted staff, not the customer
    // flow. See test/rules/hom-payment.test.js for the proof.
    match /homOrders/{orderId} {
      // BLOCK 5: ownerUid must be the caller's own uid — a client can never
      // create an order on someone else's behalf. isValidHomOrder is
      // unchanged from Block 1 (still validates customer/cabinets/pricing/
      // paymentMethod); the auth + ownership check is additive alongside it.
      allow create: if request.auth != null
        && request.resource.data.get('ownerUid', null) == request.auth.uid
        && isValidHomOrder(request.resource.data);
      // BLOCK 2 (additive to Block 1): the microsite uploads reference
      // attachments to Storage AFTER the order doc already exists (it needs
      // the real orderId as the storage path), so it must come back and
      // patch attachments[] onto its own just-created doc. BLOCK 5 narrows
      // this from "anyone" to "the order's own owner" now that every order
      // has one — request.auth.uid must equal resource.data.ownerUid. Still
      // scoped to exactly the attachments key
      // (diff().affectedKeys().hasOnly, per the project's standing
      // write-scoping convention — see jobListings/jobApplications above),
      // and to the single transition from empty to populated
      // (resource.data.get('attachments', []).size() == 0) — so this path
      // can set attachments exactly once per order, only for its owner, and
      // can never touch pricing/status/customer data. BLOCK 3 (additive to
      // Block 2): the admin/hom_admin branch (canManageHom()) is what
      // actually drives the order lifecycle — approve/reject, vendor
      // assignment, status advance — the owner-attachments branch alongside
      // it is otherwise unchanged from Block 2.
      allow update: if canManageHom()
        || (
          resource != null
          && request.auth != null
          && request.auth.uid == resource.data.get('ownerUid', null)
          && resource.data.get('attachments', []).size() == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments'])
          && request.resource.data.attachments is list
        );
      // BLOCK 5: an owner may also read back their own order (e.g. a future
      // "my orders" view or the post-purchase confirmation screen) —
      // resource == null guarded first, same defensive idiom as
      // canReadBusinessObject above, so a get() on a nonexistent order
      // resolves to "not found" rather than a rules-evaluation error.
      // Block 3's admin/hom_admin queue read is unchanged.
      allow read: if canManageHom()
        || (resource != null && request.auth != null && resource.data.get('ownerUid', null) == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── SUPPLIER ORDERS ── (admin's own purchase orders to profile/glass suppliers)
    match /homSupplierOrders/{docId} {
      allow read, write: if canManageHom();
    }

    // .get(key, default) throughout — same defensive idiom as
    // canReadBusinessObject above — a client-submitted request.resource.data
    // may simply omit a key instead of sending it null, and bare dot-access
    // on an absent map key throws a rules evaluation error instead of
    // failing validation cleanly.
    function isValidHomOrder(data) {
      let customer = data.get('customer', null);
      return customer is map
        && customer.get('name', '') is string && customer.name.size() > 0
        && customer.get('phone', '') is string && customer.phone.size() > 0
        // Pincode is OPTIONAL: '' passes (nothing entered); a non-empty
        // value must still be a real 6-digit pincode. Same relaxation,
        // for the same reason, on isValidHomOrderSite's address.pincode
        // below. Bare `customer.pincode` dot-access after the .get() check
        // still throws on a truly absent key (see the .get(key, default)
        // comment above this function) — so re-.get() it here too rather
        // than dot-accessing the already-checked value.
        && customer.get('pincode', '') is string
        && (customer.get('pincode', '') == '' || customer.get('pincode', '').matches('^[0-9]{6}$'))
        && data.get('cabinets', []) is list && data.cabinets.size() > 0
        && data.get('pricingSnapshot', null) is map
        && data.get('paymentMethod', '') in ['online', 'cod']
        && isValidHomOrderSites(data.get('sites', []));
    }

    // ── BLOCK 6: multi-site delivery (additive) ──
    // `sites` is OPTIONAL — .get('sites', []) defaults to an empty list, so
    // this is a pure no-op (trivially valid) for any write that omits it
    // entirely, which is exactly what lets a doc from before this field
    // existed keep satisfying isValidHomOrder unchanged. When present, every
    // entry must carry a real 6-digit pincode — same rule as the top-level
    // customer.pincode above, just per-site. Firestore rules have no
    // general-purpose loop/`.every()` over arbitrary-length lists, so this
    // is the standard bounded-unroll idiom: check up to MAX_HOM_SITES
    // entries, each guarded by sites.size() so indexing past the real
    // length never happens. 10 sites is far beyond anything the microsite's
    // UI drives a customer to today (see HomBuilder.jsx) — a generous,
    // deliberately-fixed cap, not a real expected maximum.
    function isValidHomOrderSites(sites) {
      return sites is list && sites.size() <= 10
        && (sites.size() < 1 || isValidHomOrderSite(sites[0]))
        && (sites.size() < 2 || isValidHomOrderSite(sites[1]))
        && (sites.size() < 3 || isValidHomOrderSite(sites[2]))
        && (sites.size() < 4 || isValidHomOrderSite(sites[3]))
        && (sites.size() < 5 || isValidHomOrderSite(sites[4]))
        && (sites.size() < 6 || isValidHomOrderSite(sites[5]))
        && (sites.size() < 7 || isValidHomOrderSite(sites[6]))
        && (sites.size() < 8 || isValidHomOrderSite(sites[7]))
        && (sites.size() < 9 || isValidHomOrderSite(sites[8]))
        && (sites.size() < 10 || isValidHomOrderSite(sites[9]));
    }

    function isValidHomOrderSite(site) {
      return site is map
        && site.get('siteId', '') is string && site.siteId.size() > 0
        && site.get('label', '') is string && site.label.size() > 0
        && site.get('address', null) is map
        // Optional, same relaxation (and the same re-.get() to avoid a
        // bare-dot-access error on a truly absent key) as isValidHomOrder's
        // customer.pincode.
        && site.address.get('pincode', '') is string
        && (site.address.get('pincode', '') == '' || site.address.get('pincode', '').matches('^[0-9]{6}$'));
    }
    // ══ END HOM SYSTEMS — BLOCK 1 ═══════════════════════════════

    // L10/L9: admin-set launch config (config/pricing). Public read so the
    // screens can show limits and prices; only the TIN admin writes.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin() && (docId != "pricing" || pricingConfigOk(request.resource.data));
    }
    // L9: config/pricing shape — whole rupees, offer ≤ list, limit 1..999.
    function pricingFeeOk(f) {
      return f is map && f.list is int && f.offer is int && f.launchDiscount is bool
        && f.list >= 0 && f.list <= 100000 && f.offer >= 0 && f.offer <= f.list;
    }
    function pricingConfigOk(d) {
      return pricingFeeOk(d.get("profileFee", null)) && pricingFeeOk(d.get("jobPostFee", null))
        && d.get("betaMode", true) is bool
        && d.get("shortlistLimit", 0) is int && d.get("shortlistLimit", 0) >= 1 && d.get("shortlistLimit", 0) <= 999
        // A2: shortlists from search per employer per day (0 = off).
        && d.get("searchShortlistDailyLimit", 20) is int && d.get("searchShortlistDailyLimit", 20) >= 0 && d.get("searchShortlistDailyLimit", 20) <= 500;
    }

    // ── ENTITLEMENTS ── (L9: no payments yet)
    // Each free job-seeker profile or job post is recorded for 365 days so
    // history exists when payments start. The owner creates it with the
    // profile's first save / in the job's create batch; only admin edits.
    match /entitlements/{entId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.get("uid", "") == request.auth.uid);
      allow create: if isAdmin() || (request.auth != null && entitlementOk(entId, request.resource.data));
      allow update, delete: if isAdmin();
    }
    function entitlementOk(entId, d) {
      return d.keys().hasOnly(["uid", "kind", "refId", "priceList", "priceOffer", "launchDiscount", "pricePaid", "reason", "grantedAt", "validDays", "validUntil"])
        && d.uid == request.auth.uid
        && d.kind in ["job_profile", "job_post"]
        && d.refId is string && entId == d.kind + "_" + d.refId
        && d.pricePaid == 0
        && d.priceList is int && d.priceOffer is int && d.launchDiscount is bool
        && d.reason in ["launch_discount", "payments_not_live"]
        && d.grantedAt == request.time
        && d.validDays == 365
        && d.validUntil is timestamp
        && d.validUntil > request.time + duration.value(364, "d")
        && d.validUntil < request.time + duration.value(366, "d")
        && (d.kind == "job_profile"
            ? d.refId == request.auth.uid
            : getAfter(/databases/$(database)/documents/jobListings/$(d.refId)).data.get("postedByUid", "") == request.auth.uid);
    }
    // Beta mode (Admin → Pricing, config/pricing.betaMode): ON unless the admin
    // has switched it off. ON = no shortlist limit per job.
    function betaMode() {
      return !exists(/databases/$(database)/documents/config/pricing)
        || get(/databases/$(database)/documents/config/pricing).data.get("betaMode", true) != false;
    }
    // Per-job shortlist limit (config/pricing.shortlistLimit, default 10).
    // In beta: the highest slot number there is.
    function shortlistLimit() {
      return betaMode() ? 999999
        : get(/databases/$(database)/documents/config/pricing).data.get("shortlistLimit", 10);
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "enayathsheik@gmail.com";
    }

    // ── HOM SYSTEMS SCOPED ADMIN (Block 3) ──
    // Same mechanism the rest of the app already uses for roles: a plain
    // `role` field on the user's own users/{uid} doc (see App.jsx's existing
    // profile.role handling) — hom_admin is just another value alongside
    // consumer/retailer/contractor/architect/contributor, not a new roles
    // system. exists() is checked before get() since a brand-new auth user
    // may not have a users/{uid} doc yet (same defensive shape as
    // isActiveMemberOf above) — reading .data off a nonexistent doc would
    // throw a rules evaluation error rather than cleanly resolving to "not
    // hom_admin".
    function isHomAdminRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'hom_admin';
    }

    // Every HOM Systems management write in this file is gated on this,
    // not on isAdmin() or isHomAdminRole() directly — the single call site
    // to widen if a third way to manage HOM Systems is ever added.
    function canManageHom() {
      return isAdmin() || isHomAdminRole();
    }

    function isConversationParticipant(conversationId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
    }

    // ── AI RECORD ACCESS (org OR personal ownerUid) ──
    function canReadAiRecord(data) {
      return (data.orgId != null && isActiveMember(data.orgId))
        || (data.ownerUid != null && data.ownerUid == request.auth.uid);
    }

    // ── CONVERSATION ACCESS — CONTEXT-BASED (Phase 1) ──
    // `.get('context', null)` — NOT bare `.context` — everywhere below: a
    // real un-backfilled doc has no `context` KEY at all (absent, not
    // explicitly null), and bare dot-access on a genuinely absent map key
    // throws a rules evaluation error ("Property context is undefined on
    // object") instead of returning null, which would break every read of
    // every pre-Phase-1 doc until the backfill runs. .get(key, default) is
    // the safe accessor for a key that may not exist at all.
    function canReadConversation(data) {
      return data.get('context', null) == 'personal'
        ? request.auth.uid in data.participantUids
        : data.get('context', null) == 'organization'
          ? (isActiveMember(data.orgId) && canAccessOrgConversation(data))
          : legacyCanReadConversation(data); // context==null
    }

    // Byte-identical to the pre-Phase-1 top-level read predicate, which gave
    // scope=='external' its OWN branch — signedIn() + participancy only, no
    // isActiveMember(orgId) at all (that bypass was the entire point of
    // Phase D). A uniform `isActiveMember(orgId) && canAccessConversation()`
    // fallback would silently re-impose the org-membership requirement Phase
    // D removed for every un-backfilled external-scope doc — this exists
    // specifically to not do that.
    function legacyCanReadConversation(data) {
      return data.scope == 'external'
        ? request.auth.uid in data.participantUids
        : (isActiveMember(data.orgId) && canAccessConversation(data));
    }

    function canCreateConversation(data) {
      return data.get('context', null) == 'personal'
        ? canCreatePersonalConversation(data)
        : (data.get('context', null) == 'organization' && canCreateOrgConversation(data));
    }

    function canUpdateConversation(before, after) {
      return before.get('context', null) == 'personal'
        ? canUpdatePersonalConversation(before, after)
        // organization AND legacy (context==null) both use the identical,
        // unchanged update predicate that applied unconditionally before
        // this deploy.
        : canUpdateOrgConversation(before, after);
    }

    // scope == 'org': every call site above already requires
    // isActiveMember(data.orgId) before reaching here, so no further check
    // is needed — matches the original canAccessConversation's
    // `data.scope == 'org' && isActiveMember(...)` exactly.
    function canAccessOrgConversation(data) {
      return data.scope == 'team'
        ? (request.auth.uid in data.participantUids ||
            (data.teamId != null && data.teamId in member(data.orgId).teamIds))
        : true;
    }

    // 1:1 personal create: exactly the creator + one named counterparty (no
    // third-party uid injection). Cross-org / no-shared-org: born
    // status:'requested' — the one-way pre-accept gate. Same-org exemption:
    // may be born status:'accepted' directly IF `sharedOrgId` names an org
    // both participants are genuinely, currently active members of — proven
    // here via real get() lookups, never taken on the client's word (see
    // bothActiveMembersOf). Group personal create: no accept-gate in
    // Phase 1, always born status:'accepted'.
    function canCreatePersonalConversation(data) {
      return data.createdBy == request.auth.uid
        && request.auth.uid in data.participantUids
        && (
          (data.type == 'direct'
            && data.participantUids.size() == 2
            && (
              data.status == 'requested'
              || (data.status == 'accepted'
                  && data.get('sharedOrgId', null) != null
                  && bothActiveMembersOf(data.sharedOrgId, data.participantUids))
              // Jobs phase 5a: a candidate and the employer of a job they
              // applied to — applying is the consent (see applicationLinksPair).
              || (data.status == 'accepted'
                  && applicationLinksPair(data.get('viaApplication', null), data.participantUids))
            ))
          || (data.type == 'group' && data.status == 'accepted')
        );
    }

    // Parameterized sibling of isActiveMember(orgId) (which is always
    // implicitly for request.auth.uid) — used only by the same-org
    // accept-gate exemption above, to check an arbitrary OTHER participant's
    // membership. get()/exists() in rules read the real document regardless
    // of whether the caller could independently read it via a client query,
    // so this can't be spoofed by a client claiming a shared org that isn't
    // real.
    function isActiveMemberOf(orgId, uid) {
      return exists(/databases/$(database)/documents/memberships/$(orgId + '_' + uid))
        && get(/databases/$(database)/documents/memberships/$(orgId + '_' + uid)).data.status == 'active';
    }

    function bothActiveMembersOf(orgId, uids) {
      return isActiveMemberOf(orgId, uids[0]) && isActiveMemberOf(orgId, uids[1]);
    }

    // Identical to the pre-Phase-1 conversation create rule (minus the
    // scope != 'external' guard, now redundant since external is subsumed
    // into context == 'personal' and can never reach this branch) — zero
    // regression for organization-context creates.
    function canCreateOrgConversation(data) {
      return isActiveMember(data.orgId)
        && data.createdBy == request.auth.uid
        && request.auth.uid in data.participantUids
        && (data.scope != 'org' || hasRole(data.orgId, ['owner', 'admin', 'manager']));
    }

    // lastMessageAt: mirrors sendMessage's batch update, gated to whoever can
    // currently write messages (accepted, or the pre-accept initiator).
    // linkedEntities: mirrors linkEntity(), open to either participant
    // regardless of accept state. status: only the non-creator participant
    // may flip 'requested' -> 'accepted' — the recipient accepting, never
    // the initiator self-accepting.
    function canUpdatePersonalConversation(before, after) {
      return request.auth.uid in before.participantUids
        && (
          (after.diff(before).affectedKeys().hasOnly(['lastMessageAt'])
            && (before.status == 'accepted' || request.auth.uid == before.createdBy))
          || after.diff(before).affectedKeys().hasOnly(['linkedEntities'])
          || (after.diff(before).affectedKeys().hasOnly(['status'])
            && before.type == 'direct'
            && before.status == 'requested'
            && after.status == 'accepted'
            && request.auth.uid != before.createdBy)
          // Jobs phase 5a: either side may open an earlier 'requested'
          // thread once there's an application linking exactly these two.
          || (after.diff(before).affectedKeys().hasOnly(['status', 'viaApplication'])
            && before.type == 'direct'
            && before.get('status', '') == 'requested'
            && after.get('status', '') == 'accepted'
            && applicationLinksPair(after.get('viaApplication', null), before.participantUids))
        );
    }

    // Jobs phase 5a: true only when jobApplications/{appId} exists, isn't
    // withdrawn, and its applicant and its job's poster are exactly the two
    // participants (two different people). Nothing on the conversation is
    // taken on the client's word — both docs are read here.
    function applicationLinksPair(appId, uids) {
      return appId is string
        && uids.size() == 2
        && exists(/databases/$(database)/documents/jobApplications/$(appId))
        && applicationLinks(get(/databases/$(database)/documents/jobApplications/$(appId)).data, uids);
    }
    function applicationLinks(app, uids) {
      return app.get('stage', '') != 'withdrawn'
        && app.get('applicantUid', '') in uids
        && exists(/databases/$(database)/documents/jobListings/$(app.get('jobId', '')))
        && jobPosterLinks(get(/databases/$(database)/documents/jobListings/$(app.get('jobId', ''))).data.get('postedByUid', ''), app.get('applicantUid', ''), uids);
    }
    function jobPosterLinks(posterUid, applicantUid, uids) {
      return posterUid != '' && posterUid != applicantUid && posterUid in uids;
    }

    // Identical to the pre-Phase-1 update rule, which applied unconditionally
    // to every conversation before this deploy — kept byte-identical for both
    // context=='organization' and legacy (context==null) docs. Zero regression.
    function canUpdateOrgConversation(before, after) {
      return (request.auth.uid in before.participantUids || hasRole(before.orgId, ['owner', 'admin']))
        && (after.scope == before.scope || hasRole(before.orgId, ['owner', 'admin', 'manager']));
    }

    // ── MESSAGE ACCESS — CONTEXT-BASED (Phase 1) ──
    // convData is an already-fetched parent conversation's .data (callers
    // pass the result of a single get(), never re-fetched here). Same
    // `.get('context', null)` safety as canReadConversation above — a real
    // un-backfilled conversation doc has no `context` key at all.
    function canReadMessage(convData) {
      return convData.get('context', null) == 'personal'
        ? request.auth.uid in convData.participantUids
        : convData.get('context', null) == 'organization'
          ? (isActiveMember(convData.orgId) && canAccessOrgConversation(convData))
          : legacyCanReadConversation(convData); // context==null — same external-scope bypass as canReadConversation
    }

    // Pre-accept one-way gate: only the conversation's createdBy may write
    // while status == 'requested'; once accepted, either participant may.
    function canCreateMessage(convData) {
      return convData.get('context', null) == 'personal'
        ? (request.auth.uid in convData.participantUids
            && (convData.status == 'accepted' || request.auth.uid == convData.createdBy))
        : convData.get('context', null) == 'organization'
          ? (isActiveMember(convData.orgId) && canAccessOrgConversation(convData))
          : legacyCanCreateMessage(convData); // context==null
    }

    // Byte-identical to the pre-Phase-1 canCreateMessage: scope=='external'
    // bypasses isActiveMember(orgId) (same rationale as
    // legacyCanReadConversation) AND additionally requires the message's
    // own senderOrgId be one of the parent's participantOrgIds — a sender in
    // a legacy external thread can only stamp their own side's org onto a
    // message, never the counterparty's. request.resource.data is available
    // directly here (it's the document actually being created), same as
    // every other function in this ruleset reaches request.auth directly.
    function legacyCanCreateMessage(convData) {
      return convData.scope == 'external'
        ? (request.auth.uid in convData.participantUids
            && request.resource.data.senderOrgId in convData.participantOrgIds)
        : (isActiveMember(convData.orgId) && canAccessConversation(convData));
    }

    // ── TENANCY HELPERS ──
    function signedIn() {
      return request.auth != null;
    }

    function mId(orgId) {
      return orgId + '_' + request.auth.uid;
    }

    function hasMembership(orgId) {
      return exists(/databases/$(database)/documents/memberships/$(mId(orgId)));
    }

    function member(orgId) {
      return get(/databases/$(database)/documents/memberships/$(mId(orgId))).data;
    }

    function isActiveMember(orgId) {
      return hasMembership(orgId) && member(orgId).status == 'active';
    }

    function hasRole(orgId, roles) {
      return isActiveMember(orgId) && member(orgId).role in roles;
    }

    // LEGACY (context==null docs only) — reached exclusively via the
    // context==null fallback branches above; left byte-identical to its
    // pre-Phase-1 form so an un-backfilled doc's behavior never changes.
    // participantUids doubles as the field name spec'd as "participants" —
    // kept as participantUids so functions/vendor/ai-foundation's context
    // builder (which reads conversation.participantUids) keeps working.
    function canAccessConversation(data) {
      return
        (data.scope == 'personal' && request.auth.uid in data.participantUids) ||
        (data.scope == 'team' && (request.auth.uid in data.participantUids ||
          (data.teamId != null && data.teamId in member(data.orgId).teamIds))) ||
        (data.scope == 'org' && isActiveMember(data.orgId)) ||
        (data.scope == 'external' && request.auth.uid in data.participantUids);
    }
  }
}
