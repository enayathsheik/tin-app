rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── INSPI ────────────────────────────────────────────────
    match /inspi/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 30 * 1024 * 1024)
        );
    }

    // ── JOB APPLICATION RESUMES ─────────────────────────────────
    match /resumes/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
        );
    }

    // ── CONVERSATION ATTACHMENTS ─────────────────────────────
    // Tenant/participant scoping already happens at the Firestore layer —
    // only a conversation participant can create the message doc that
    // references this file (see firestore.rules' messages create rule) —
    // so this mirrors the same auth-gated, size-capped pattern already used
    // for inspi/resumes above rather than re-deriving org membership here.
    match /{orgId}/conversations/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }

    // ── HOM ORDER ATTACHMENTS ── (Block 2, additive)
    // Reference drawings/photos the customer attaches to a homOrders order.
    // The microsite has no auth, so — like the homOrders create rule itself
    // (see firestore.rules) — write is public, capped by size/type only.
    // Read stays admin-only: unlike inspi/profiles these aren't meant to be
    // publicly browsable, and there's no customer uid to scope a narrower
    // read to. Firestore's homOrders read rule is the actual admin-only
    // gate on ever discovering a file's download URL in the first place —
    // this mirrors that same isAdmin() check so the file itself is equally
    // protected if the URL ever leaks.
    match /hom/orders/{orderId}/{fileName} {
      allow read: if isHomAdmin();
      allow create: if request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow update, delete: if isHomAdmin();
    }

    function isHomAdmin() {
      return request.auth != null && request.auth.token.email == "enayathsheik@gmail.com";
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
