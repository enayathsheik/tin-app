rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── INSPI ────────────────────────────────────────────────
    match /inspi/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 30 * 1024 * 1024)
        );
    }

    // ── JOB APPLICATION RESUMES ─────────────────────────────────
    // Read/list: only the CV's owner and the TIN admin. Employers open a CV
    // through the download link saved on the jobApplications doc they can
    // read (applicant or job poster only, see firestore.rules) — download
    // links carry their own token and don't go through these rules, so
    // CVs already sent to employers keep opening exactly as before.
    match /resumes/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isTinAdmin());
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
        );
    }

    // ── CONVERSATION ATTACHMENTS ─────────────────────────────
    // Tenant/participant scoping already happens at the Firestore layer —
    // only a conversation participant can create the message doc that
    // references this file (see firestore.rules' messages create rule) —
    // so this mirrors the same auth-gated, size-capped pattern already used
    // for inspi/resumes above rather than re-deriving org membership here.
    match /{orgId}/conversations/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }

    // ── HOM ORDER ATTACHMENTS ── (Block 2, additive)
    // Reference drawings/photos the customer attaches to a homOrders order.
    // The microsite has no auth, so — like the homOrders create rule itself
    // (see firestore.rules) — write is public, capped by size/type only.
    // Read stays admin-only: unlike inspi/profiles these aren't meant to be
    // publicly browsable, and there's no customer uid to scope a narrower
    // read to. Firestore's homOrders read rule is the actual admin-only
    // gate on ever discovering a file's download URL in the first place —
    // this mirrors that same isAdmin() check so the file itself is equally
    // protected if the URL ever leaks.
    match /hom/orders/{orderId}/{fileName} {
      allow read: if isHomAdmin();
      allow create: if request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow update, delete: if isHomAdmin();
    }

    // ── HOM CATALOG PHOTOS ── (Block 3, additive)
    // Profile/colour/glass reference photos the admin/hom_admin uploads
    // while editing homConfig/catalog — the resulting download URL is
    // stored on that item's photos[] array (see src/utils/homAdmin.js).
    // Image-only, size-limited, same shape as every other upload rule in
    // this file. Read is public (not isHomManager()-gated): the microsite
    // itself renders these photos with no auth at all (see
    // src/pages/hom/HomBuilder.jsx's PhotoGallery), same as homConfig's
    // Firestore read rule being public.
    match /hom/catalog/{itemType}/{itemId}/{fileName} {
      allow read: if true;
      allow write: if isHomManager()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Block-2's order-attachment read stays exactly isHomAdmin() (master
    // admin only, unchanged) — this task's own instructions say to keep
    // that rule intact. isHomManager() is a SEPARATE, wider check (used
    // only by the new hom/catalog/ path above) so hom_admin gets the
    // catalogue-management access Block 3 actually asks for, without
    // touching Block 2's order-attachment behavior at all.
    function isHomAdmin() {
      return request.auth != null && request.auth.token.email == "enayathsheik@gmail.com";
    }

    // ── CVs: per job + saved profile CV ── (Jobs redesign phase 4)
    // New CVs live in the job's folder so access can be checked LIVE against
    // that job's application: the candidate, the TIN admin, or the poster of
    // that job while the application exists and isn't withdrawn. No
    // permanent download link is created or saved by the app. (Old flat
    // resumes/{uid}/{fileName} files above keep their saved links.)
    match /resumes/{uid}/{jobId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isTinAdmin() || employerCanReadCv(uid, jobId));
      allow write: if cvUploadOk(uid);
    }
    // The candidate's saved CV (resumes/{uid}/profile/…): owner + admin only
    // (the employer check above can't match "profile" — there's no
    // application with that id).
    match /resumes/{uid}/profile/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTinAdmin());
      allow write: if cvUploadOk(uid);
    }

    function cvUploadOk(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
        );
    }
    // Owner decision: the employer loses access when the candidate withdraws.
    // L8: …and only once the application reached Shortlisted or later
    // (contactUnlockedAt, or an old application already at such a stage) —
    // mirrors firestore.rules contactUnlocked().
    function employerCanReadCv(uid, jobId) {
      return firestore.exists(/databases/(default)/documents/jobApplications/$(jobId + "_" + uid))
        && firestore.get(/databases/(default)/documents/jobApplications/$(jobId + "_" + uid)).data.get("stage", "submitted") != "withdrawn"
        && firestore.get(/databases/(default)/documents/jobListings/$(jobId)).data.get("postedByUid", "") == request.auth.uid
        && cvContactUnlocked(firestore.get(/databases/(default)/documents/jobApplications/$(jobId + "_" + uid)).data);
    }
    function cvContactUnlocked(d) {
      return d.get("contactUnlockedAt", null) != null
        || d.get("stage", "") in ["shortlisted", "contacted", "int_invited", "int_scheduled", "int_rescheduled", "int_done",
                                  "info_req", "assess_req", "selected", "offer_sent", "offer_accepted", "offer_declined"]
        || (d.get("stage", "") == "" && d.get("applicantStatus", "") in ["shortlisted", "hired"]);
    }

    // Mirrors firestore.rules' isAdmin() (the TIN admin account).
    function isTinAdmin() {
      return request.auth != null && request.auth.token.get("email", "") == "enayathsheik@gmail.com";
    }

    // Mirrors firestore.rules' canManageHom() (isAdmin() OR a `role: 'hom_admin'`
    // field on the caller's own users/{uid} doc) via a cross-service
    // firestore.get() read — Storage rules can read Firestore data this way.
    // (default) is a literal, not a variable — Storage rules cross-service
    // calls always resolve against the CLI's actual configured project (see
    // .firebaserc), not any per-request "database" binding; confirmed
    // empirically against the emulator while building this. exists() first,
    // same reasoning as firestore.rules' isHomAdminRole(): a brand-new auth
    // user may have no users/{uid} doc yet, and get() on a path that
    // doesn't exist throws a rules evaluation error rather than cleanly
    // resolving to "not hom_admin".
    function isHomManager() {
      return isHomAdmin()
        || (
          request.auth != null
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'hom_admin'
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
