{
  "name": "tin-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.js && node scripts/prerender.js",
