# OpenAI model per AI feature (not secret). Each function reads only its
# own pair, so changing one never changes the other. After a change,
# redeploy only that function, e.g.
#   firebase deploy --only functions:suggestJobProfile
# Reasoning effort: leave empty for non-reasoning models (gpt-4o-mini);
# use "none" for reasoning models such as gpt-6-luna.
# gpt-4o-mini shuts down Jan 14, 2027 — see docs/JOBS_BLUEPRINT.md §8.

# onMessageCreate (conversation message classifier)
AI_CLASSIFIER_MODEL=gpt-4o-mini
AI_CLASSIFIER_REASONING_EFFORT=

# suggestJobProfile ("Fill it for me" profile helper)
AI_PROFILE_MODEL=gpt-4o-mini
AI_PROFILE_REASONING_EFFORT=
